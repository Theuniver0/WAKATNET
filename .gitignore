# Claude Code
.claude/worktrees/
.claude/settings.local.json

# Secrets : créés et remplis à la main par Yacouba, jamais versionnés
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
**/secrets/
*.key
*.pem
# Certificats PUBLICS seulement (aucune clé) : racines TLS de l'API importées par la commande d'enrôlement, et
# certificats d'essai des tests. Toute autre exception est interdite.
!infra/tls/racines-api.pem
!apps/api/tests/racines-essai/racine.pem
!apps/api/tests/racines-essai/feuille.pem
*.p12
*.pfx
wireguard/*.conf
infra/**/clients.local.conf

# Dépendances et artefacts
node_modules/
dist/
build/
coverage/
*.log
# Preuves de labo : versionnées (valeurs de labo uniquement)
!infra/lab/freeradius/evidence/*.log
!infra/dev/evidence/*.log
!infra/lab/latence/evidence/**/*.log
!docs/labo/**/*.log
__pycache__/
.venv/
