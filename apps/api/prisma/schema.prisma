generator client {
  provider            = "prisma-client"
  output              = "../genere/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model audit_log {
  id        BigInt   @id @default(autoincrement())
  tenant_id BigInt?
  le        DateTime @default(now()) @db.Timestamptz(6)
  acteur    String
  action    String
  objet     String
  details   Json     @default("{}")
  tenant    tenant?  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plan {
  id               BigInt          @id @default(autoincrement())
  tenant_id        BigInt
  nom              String
  prix_xof         BigInt
  uptime_limit_s   Int?
  validity_s       Int?
  data_limit_bytes BigInt?
  rate_limit       String?
  devices          Int             @default(1)
  bind_mac         Boolean         @default(false)
  scope            String          @default("tenant")
  site_id          BigInt?
  actif            Boolean         @default(true)
  payment          payment[]
  tenant           tenant          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site             site?           @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  voucher          voucher[]
  voucher_batch    voucher_batch[]

  @@unique([tenant_id, id])
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model router {
  id                   BigInt             @id @default(autoincrement())
  tenant_id            BigInt
  site_id              BigInt
  overlay_ip           String             @unique @db.Inet
  shortname            String             @unique
  actif                Boolean            @default(true)
  epoch                BigInt             @default(0)
  require_ma_exception Boolean            @default(false)
  coa_port             Int                @default(1700)
  dernier_acct_on_le   DateTime?          @db.Timestamptz(6)
  wg_public_key        String?            @unique
  inventaire           Json               @default("{}")
  enrole_le            DateTime?          @db.Timestamptz(6)
  ip_publique          String?            @db.Inet
  ip_vue_le            DateTime?          @db.Timestamptz(6)
  enrollment_token     enrollment_token[]
  site                 site               @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("app")
}

model site {
  id                     BigInt                   @id @default(autoincrement())
  tenant_id              BigInt
  nom                    String
  public_id              String                   @unique @default(dbgenerated("translate(encode(gen_random_bytes(12), 'base64'::text), '+/'::text, '-_'::text)"))
  hotspot_hotes          String[]                 @default([])
  enrollment_token       enrollment_token[]
  payment                payment[]
  plan                   plan[]
  recuperation_tentative recuperation_tentative[]
  router                 router[]
  tenant                 tenant                   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voucher                voucher[]

  @@unique([tenant_id, id])
  @@schema("app")
}

model tenant {
  id                  BigInt           @id @default(autoincrement())
  nom                 String
  suspendu            Boolean          @default(false)
  cree_le             DateTime         @default(now()) @db.Timestamptz(6)
  settlement_mode     String           @default("A")
  commission_bps      Int              @default(1000)
  commission_min      BigInt           @default(0)
  offline_fee_bps     Int              @default(1000)
  offline_fee_min     BigInt           @default(10)
  plafond_decouvert   BigInt           @default(3000)
  frais_papier_depuis DateTime         @default(now()) @db.Timestamptz(6)
  quota_routeurs      Int              @default(2)
  valide_admin        Boolean          @default(false)
  audit_log           audit_log[]
  compte_marchand     compte_marchand?
  payment             payment[]
  payment_event       payment_event[]
  payout              payout[]
  plan                plan[]
  point_of_sale       point_of_sale[]
  site                site[]
  utilisateur         utilisateur[]
  voucher_batch       voucher_batch[]

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model voucher {
  id                 BigInt         @id @default(autoincrement())
  tenant_id          BigInt
  plan_id            BigInt
  code               String
  f_prix_xof         BigInt
  f_uptime_limit_s   Int?
  f_validity_s       Int?
  f_data_limit_bytes BigInt?
  f_rate_limit       String?
  f_devices          Int
  f_bind_mac         Boolean        @default(false)
  f_scope            String
  f_site_id          BigInt?
  expires_at         DateTime?      @db.Timestamptz(6)
  activated_at       DateTime?      @db.Timestamptz(6)
  cree_le            DateTime       @default(now()) @db.Timestamptz(6)
  mac_liee           String?
  origine            String         @default("wakatnet")
  batch_id           BigInt?
  payment            payment?
  voucher_batch      voucher_batch? @relation(fields: [tenant_id, batch_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "voucher_lot")
  site               site?          @relation(fields: [tenant_id, f_site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  plan               plan           @relation(fields: [tenant_id, plan_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, code])
  @@index([batch_id], map: "voucher_par_lot", where: raw("(batch_id IS NOT NULL)"))
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model enrollment_token {
  id          BigInt    @id @default(autoincrement())
  tenant_id   BigInt
  site_id     BigInt
  empreinte   Bytes     @unique
  cree_le     DateTime  @default(now()) @db.Timestamptz(6)
  expire_le   DateTime  @db.Timestamptz(6)
  consomme_le DateTime? @db.Timestamptz(6)
  router_id   BigInt?
  router      router?   @relation(fields: [router_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site        site      @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model compte_marchand {
  tenant_id   BigInt   @id
  fournisseur String
  webhook_id  String   @unique @default(dbgenerated("translate(encode(gen_random_bytes(18), 'base64'::text), '+/'::text, '-_'::text)"))
  cles        Bytes
  maj_le      DateTime @default(now()) @db.Timestamptz(6)
  tenant      tenant   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payment {
  id                    BigInt          @id @default(autoincrement())
  tenant_id             BigInt
  site_id               BigInt
  plan_id               BigInt
  montant               BigInt
  devise                String          @default("XOF")
  operateur             String
  fournisseur           String
  reference             String          @unique
  reference_fournisseur String?
  statut                String          @default("CREATED")
  numero_clair          String?
  numero_hmac           Bytes
  numero_masque         String
  purge_numero_le       DateTime        @db.Timestamptz(6)
  jeton_appareil        Bytes
  soumission            String
  voucher_id            BigInt?         @unique
  cree_le               DateTime        @default(now()) @db.Timestamptz(6)
  maj_le                DateTime        @default(now()) @db.Timestamptz(6)
  expire_le             DateTime        @db.Timestamptz(6)
  verifier_jusqu_au     DateTime        @db.Timestamptz(6)
  prochaine_verif_le    DateTime        @db.Timestamptz(6)
  detail                Json            @default("{}")
  confirme_le           DateTime?       @db.Timestamptz(6)
  tenant                tenant          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan                  plan            @relation(fields: [tenant_id, plan_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  site                  site            @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  voucher               voucher?        @relation(fields: [voucher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_event         payment_event[]

  @@unique([tenant_id, soumission])
  @@index([prochaine_verif_le], map: "payment_a_verifier", where: raw("(statut = ANY (ARRAY['CREATED'::text, 'PENDING'::text, 'EXPIRED'::text, 'FAILED'::text]))"))
  @@index([site_id, numero_hmac], map: "payment_numero")
  @@index([tenant_id, confirme_le], map: "payment_tenant_confirme_le", where: raw("(confirme_le IS NOT NULL)"))
  @@schema("app")
}

