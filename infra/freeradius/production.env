# WAKATNET — variables NON secrètes du nœud A (EnvironmentFile systemd, avec un
# second fichier réservé à root pour WAKATNET_PG_RADIUS_PASSWORD et WAKATNET_PG_ACCT_PASSWORD).
# Nœud B : WAKATNET_RADIUS_LISTEN=10.213.0.2.
# Mêmes clés que radius/tests/surcharges/test.env (vérifié par test_surcharges.py).
WAKATNET_RADIUS_LISTEN=10.213.0.1
WAKATNET_CLIENT_LIFETIME=300
WAKATNET_PG_HOST=127.0.0.1
