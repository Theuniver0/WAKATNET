# WAKATNET — secrets de DÉVELOPPEMENT (docker-compose de phase 0).
#
# Copier ce fichier en infra/dev/.env (ignoré par Git) puis remplacer
# chaque CHANGE_ME par une valeur aléatoire, par exemple la sortie de
#   openssl rand -hex 24
# Ne jamais réutiliser ces valeurs ailleurs, encore moins en production.
# Ne jamais versionner infra/dev/.env.

# PostgreSQL (lus par l'image officielle postgres)
POSTGRES_USER=wakatnet
POSTGRES_DB=wakatnet
POSTGRES_PASSWORD=CHANGE_ME

# Redis (BullMQ, phases suivantes)
REDIS_PASSWORD=CHANGE_ME

# Secret partagé RADIUS du client de dev (dev/freeradius/clients.conf),
# utilisé aussi par le service radclient du profil "tools".
RADIUS_DEV_SECRET=CHANGE_ME
