# WAKATNET — essai de restauration automatisé (SPEC §10.1 ; ADR 0015 §5).
# Ticket : .scratch/phase-5-haute-disponibilite/issues/04-sauvegardes.md
# Restaure la dernière sauvegarde dans un répertoire temporaire, contrôle le grand livre contre la
# base vivante, puis efface tout. Échec ⇒ unité en échec, vue par la supervision.
[Unit]
Description=WAKATNET : essai mensuel de restauration
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# En root, sans autres capacités que celles qu'il faut pour CONFIER chaque étape (scan de sécurité F4) : restauration
# sous postgres, instance restaurée sous l'utilisateur dédié wakatnet-essai, qui n'a accès à rien.
# CAP_SYS_ADMIN : espaces de noms et montages de l'essai (unshare) ; CAP_SETPCAP : setpriv vide le jeu de capacités
# limite avant de passer à l'utilisateur isolé. Toutes sont abandonnées par setpriv.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SYS_ADMIN
StateDirectory=wakatnet-essai
StateDirectoryMode=0711
TimeoutStartSec=6h
Nice=10
# Ressources (seconde relecture du scan F4) : l'essai cède avant la base vivante (mémoire, tâches, OOM).
OOMScoreAdjust=1000
MemoryHigh=25%
MemoryMax=40%
TasksMax=512
CPUWeight=20
IOSchedulingClass=idle
ExecStart=/opt/wakatnet/infra/noeud/essai-restauration.sh
ReadWritePaths=/var/lib/wakatnet /var/log/pgbackrest /var/spool/pgbackrest /tmp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=net mnt ipc pid
# Appels système : ceux d'un service, plus le montage (tmpfs des espaces de l'essai) ; sauf le trousseau du noyau et
# io_uring, que @system-service laisse passer. Le reste (perf, bpf, chargement de module…) est refusé, au script comme au
# code de la sauvegarde.
SystemCallFilter=@system-service @mount
SystemCallFilter=~@keyring io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
