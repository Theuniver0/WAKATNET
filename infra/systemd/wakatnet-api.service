# WAKATNET — API, portail captif, tableau de bord, webhooks (ADR 0016 §1), derrière nginx.
# Écoute sur 127.0.0.1:3000 seulement. Démarrée sur le PRIMAIRE (Ansible) ; arrêtée sur une réplique.
[Unit]
Description=WAKATNET : API, portail et tableau de bord
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
# Fichier réservé à root, jamais versionné : WAKATNET_API_DATABASE_URL, WAKATNET_CLE_MARCHANDS,
# WAKATNET_CLE_HMAC, WAKATNET_API_URL_PUBLIQUE, WAKATNET_PORTAIL_URL_PUBLIQUE, WAKATNET_PORTAIL_IPS, WAKATNET_NOEUDS,
# WAKATNET_RACINES_TLS (/opt/wakatnet/infra/tls/racines-api.pem : public, lisible par l'utilisateur dynamique).
EnvironmentFile=/etc/wakatnet/api.env
# NODE_ENV posé sur la ligne d'exécution : EnvironmentFile= l'emporterait sur Environment=.
ExecStart=/usr/bin/env NODE_ENV=production WAKATNET_API_HOTE=127.0.0.1 WAKATNET_API_PORT=3000 WAKATNET_TRUST_PROXY=127.0.0.1 /usr/bin/node /opt/wakatnet/apps/api/src/serveur.ts
Restart=on-failure
RestartSec=2s
ReadOnlyPaths=/var/lib/wakatnet
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectClock=yes
ProtectHostname=yes
# /proc réduit aux processus de l'unité : ni /proc/sys, ni /proc/meminfo, ni /proc/cpuinfo (os.cpus() rend une
# liste vide ; ni l'API ni ses dépendances ne l'appellent, vérifié le 13/11/2026).
ProtectProc=invisible
ProcSubset=pid
UMask=0077
# Appels système : relevés par strace sur Node 22 (HTTP, fetch, scrypt, fs, DNS, worker, zlib, WebAssembly), tous
# dans @system-service. Un appel hors liste rend EPERM au lieu de tuer le processus : libuv retombe alors sur son
# pool de threads (io_uring) et V8 sur la protection classique (pkey_*), comme vérifié avec EPERM injecté.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Pas de MemoryDenyWriteExecute : le JIT de Node en a besoin.

[Install]
WantedBy=multi-user.target
