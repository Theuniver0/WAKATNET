# WAKATNET — wg-agent : pairs de wg0 alignés sur la base (SPEC §6.1, ADR 0012 §1 ; ticket 05 de la phase 2).
# wg0 lui-même (clé privée, port, adresse) est créé par systemd-networkd ou wg-quick, JAMAIS par
# wg-agent : l'agent ne touche qu'aux pairs. Hors chemin critique : s'il s'arrête, les pairs
# existants restent en place ; seuls les enrôlements et révocations attendent.
[Unit]
Description=WAKATNET : réconciliation des pairs WireGuard
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Fichier réservé à root, jamais versionné : PGHOST, PGDATABASE, PGUSER=wk_wg, PGPASSWORD (S1, S2).
EnvironmentFile=/etc/wakatnet/wg-agent.env
Environment=WAKATNET_WG_INTERFACE=wg0
ExecStart=/opt/wakatnet/bin/wg-agent
Restart=always
RestartSec=5s
DynamicUser=yes
# Seule capacité : configurer les pairs par netlink (genetlink WireGuard).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# Base locale (TCP) et netlink pour wgctrl.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
