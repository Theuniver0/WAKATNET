# WAKATNET — variables NON secrètes de FreeRADIUS, nœud {{ wakatnet_noeud }} (géré par Ansible).
# Mêmes clés que infra/freeradius/production.env ; secrets dans /etc/wakatnet/freeradius.secrets.
WAKATNET_RADIUS_LISTEN={{ wg0_ip }}
WAKATNET_CLIENT_LIFETIME=300
WAKATNET_PG_HOST=127.0.0.1
WAKATNET_PG_ACCT_HOSTS=127.0.0.1,{{ wk_noeuds_pair_ip }}
