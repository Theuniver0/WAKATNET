# WAKATNET — pgBackRest (ADR 0015 §5). Géré par Ansible ; modèle : infra/pgbackrest/pgbackrest.conf.
# Secrets dans /etc/pgbackrest/conf.d/secret.conf (root:postgres, 0640), jamais ici.
[global]
repo1-type=s3
repo1-s3-endpoint={{ pgbackrest_s3_endpoint }}
repo1-s3-bucket={{ pgbackrest_s3_bucket }}
repo1-s3-region={{ pgbackrest_s3_region }}
repo1-path=/wakatnet
repo1-cipher-type=aes-256-cbc
repo1-retention-full=4
compress-type=zst
start-fast=y
process-max=1
log-level-console=warn
log-level-file=info

[wakatnet]
pg1-path={{ postgresql_data_dir }}
