# syntax=docker/dockerfile:1
# WAKATNET — nœud d'ESSAI pour les rôles Ansible (ticket 06 de la phase 5). TEST SEULEMENT.
# Ubuntu 24.04 avec systemd : les dépôts Debian ne sont pas joignables depuis l'environnement de
# développement (proxy). Les paquets sont installés à la construction (réseau de l'hôte) ; les
# conteneurs, reliés par un réseau privé, ne joignent pas le proxy : les tâches apt d'Ansible
# trouvent les paquets et un cache récent (cache_valid_time). Le nœud réel est sous Debian 13.
FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
# HTTPS seulement derrière le proxy du poste de développement (certificat monté) : l'image de base n'a aucune
# autorité de certification, et sans proxy (CI) apt reste en http, ses index étant de toute façon signés (GPG).
RUN --mount=type=secret,id=ca,target=/ca.crt,required=false \
    if [ -s /ca.crt ]; then install -m 0644 /ca.crt /tmp/ca.crt \
      && sed -i 's#http://#https://#g' /etc/apt/sources.list.d/ubuntu.sources \
      && echo 'Acquire::https::CAInfo "/tmp/ca.crt";' > /etc/apt/apt.conf.d/99ca; fi \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd systemd-sysv sudo python3 \
      postgresql-16 postgresql-client-16 freeradius freeradius-postgresql pgbackrest nftables wireguard-tools \
      unattended-upgrades logrotate curl xz-utils ca-certificates nginx openssl \
 && rm -f /etc/apt/apt.conf.d/99ca /tmp/ca.crt
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
